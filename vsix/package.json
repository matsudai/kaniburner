{
  "name": "kaniburner",
  "displayName": "kaniburner",
  "version": "0.1.0",
  "description": "mruby compiler and mrbwrite writer",
  "publisher": "matsudai",
  "repository": {
    "type": "git",
    "url": "https://github.com/matsudai/kaniburner"
  },
  "main": "./out/main.js",
  "engines": {
    "vscode": "^1.113.0"
  },
  "contributes": {
    "commands": [
      { "command": "kaniburner.write",             "category": "kaniburner", "title": "Compile & Write",      "icon": "$(cloud-upload)",     "enablement": "kaniburner.canWrite" },
      { "command": "kaniburner.execute",           "category": "kaniburner", "title": "Execute",              "icon": "$(play)",             "enablement": "kaniburner.canExecute" },
      { "command": "kaniburner.restart",             "category": "kaniburner", "title": "Restart",              "icon": "$(debug-restart)",    "enablement": "kaniburner.canRestart" },
      { "command": "kaniburner.connect",           "category": "kaniburner", "title": "Connect",              "icon": "$(plug)",             "enablement": "kaniburner.canConnect" },
      { "command": "kaniburner.cancel",           "category": "kaniburner", "title": "Cancel",              "icon": "$(close)",             "enablement": "kaniburner.canCancel" },
      { "command": "kaniburner.disconnect",        "category": "kaniburner", "title": "Disconnect",           "icon": "$(debug-disconnect)", "enablement": "kaniburner.canDisconnect" },
      { "command": "kaniburner.selectVersion",     "category": "kaniburner", "title": "Select mruby Version", "icon": "$(edit)" },
      { "command": "kaniburner.selectBaud",        "category": "kaniburner", "title": "Select Baud Rate",     "icon": "$(edit)" },
      { "command": "kaniburner.selectPort",        "category": "kaniburner", "title": "Select Serial Port",   "icon": "$(edit)" },
      { "command": "kaniburner.addLibrary",          "category": "kaniburner", "title": "Add Library", "icon": "$(add)" },
      { "command": "kaniburner.addTask",             "category": "kaniburner", "title": "Add Task", "icon": "$(add)" },
      { "command": "kaniburner.moveProjectFileUp",   "category": "kaniburner", "title": "Move Up", "icon": "$(arrow-up)" },
      { "command": "kaniburner.moveProjectFileDown", "category": "kaniburner", "title": "Move Down", "icon": "$(arrow-down)" },
      { "command": "kaniburner.removeProjectFile",   "category": "kaniburner", "title": "Remove", "icon": "$(remove)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "kaniburner", "title": "kaniburner", "icon": "media/kaniburner.svg" }
      ]
    },
    "views": {
      "kaniburner": [
        { "id": "kaniburner.project", "name": "Project" },
        { "id": "kaniburner.device",  "name": "Device & Compiler" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kaniburner.project",
        "contents": "プロジェクトを使うにはフォルダを開いてください。\n[フォルダを開く](command:workbench.action.files.openFolder)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "kaniburner.connect",    "when": "view == kaniburner.project && !kaniburner.canCancel", "group": "navigation@1" },
        { "command": "kaniburner.cancel",     "when": "view == kaniburner.project && kaniburner.canCancel", "group": "navigation@1" },
        { "command": "kaniburner.disconnect", "when": "view == kaniburner.project", "group": "navigation@2" },
        { "command": "kaniburner.write",      "when": "view == kaniburner.project", "group": "navigation@3" },
        { "command": "kaniburner.execute",    "when": "view == kaniburner.project", "group": "navigation@4" },
        { "command": "kaniburner.restart",      "when": "view == kaniburner.project", "group": "navigation@5" }
      ],
      "view/item/context": [
        {
          "command": "kaniburner.addLibrary",
          "when": "view == kaniburner.project && viewItem == librariesParent",
          "group": "inline"
        },
        {
          "command": "kaniburner.addTask",
          "when": "view == kaniburner.project && viewItem == tasksParent",
          "group": "inline"
        },
        {
          "command": "kaniburner.moveProjectFileUp",
          "when": "view == kaniburner.project && viewItem =~ /^projectFile(Mid|Last)$/",
          "group": "inline@1"
        },
        {
          "command": "kaniburner.moveProjectFileDown",
          "when": "view == kaniburner.project && viewItem =~ /^projectFile(First|Mid)$/",
          "group": "inline@2"
        },
        {
          "command": "kaniburner.removeProjectFile",
          "when": "view == kaniburner.project && viewItem =~ /^projectFile/",
          "group": "inline@3"
        },
        {
          "command": "kaniburner.selectPort",
          "when": "view == kaniburner.device && viewItem == devicePort",
          "group": "inline"
        },
        {
          "command": "kaniburner.selectBaud",
          "when": "view == kaniburner.device && viewItem == deviceBaud",
          "group": "inline"
        },
        {
          "command": "kaniburner.selectVersion",
          "when": "view == kaniburner.device && viewItem == deviceVersion",
          "group": "inline"
        }
      ],
      "explorer/context": [
        { "command": "kaniburner.addLibrary", "when": "resourceExtname == .rb || explorerResourceIsFolder", "group": "kaniburner@1" },
        { "command": "kaniburner.addTask",    "when": "resourceExtname == .rb || explorerResourceIsFolder", "group": "kaniburner@2" }
      ],
      "editor/title/context": [
        { "command": "kaniburner.addLibrary", "when": "resourceExtname == .rb", "group": "kaniburner@1" },
        { "command": "kaniburner.addTask",    "when": "resourceExtname == .rb", "group": "kaniburner@2" }
      ],
      "commandPalette": [
        { "command": "kaniburner.write", "when": "kaniburner.connected" },
        { "command": "kaniburner.moveProjectFileUp", "when": "false" },
        { "command": "kaniburner.moveProjectFileDown", "when": "false" },
        { "command": "kaniburner.removeProjectFile", "when": "false" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.113.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  }
}
